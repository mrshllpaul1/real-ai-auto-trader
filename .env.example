# AI Crypto Auto Trading Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials!

# ==============================================================================
# AI & LLM SERVICES
# ==============================================================================

# Emergent LLM Key (Required for AI strategy generation)
# Get from: https://emergent.ai
EMERGENT_LLM_KEY=your_emergent_llm_key_here

# ==============================================================================
# CRYPTOCURRENCY EXCHANGE APIs (for Real Trading)
# ==============================================================================

# Kraken Exchange (Primary)
# Get from: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Create & Modify Orders, Cancel/Close Orders
# ⚠️ NEVER enable "Withdraw" permission for security
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# Binance Exchange (Optional)
# Get from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Coinbase Exchange (Optional)
# Get from: https://www.coinbase.com/settings/api
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# ==============================================================================
# MARKET DATA APIS
# ==============================================================================

# CoinMarketCap API (for market data)
# Get from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here

# CoinStats API
# Get from: https://coinstats.app/api
COINSTATS_API_KEY=your_coinstats_key_here

# TwelveData API (for historical data)
# Get from: https://twelvedata.com/apikey
TWELVEDATA_API_KEY=your_twelvedata_key_here

# CryptoPanic API (for news sentiment)
# Get from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# CoinDesk API
COINDESK_API_KEY=your_coindesk_key_here

# Etherscan API (for Ethereum blockchain data)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_key_here

# ==============================================================================
# EMAIL & NOTIFICATIONS
# ==============================================================================

# Resend API for email alerts
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email addresses for notifications
SENDER_EMAIL=your_sender@example.com
ALERT_EMAIL=your_alert_recipient@example.com

# ==============================================================================
# DATABASE
# ==============================================================================

# MongoDB Connection String
# Format: mongodb://[username:password@]host[:port][/database]
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URL=mongodb://localhost:27017
DB_NAME=crypto_trading_db

# ==============================================================================
# SECURITY & ENCRYPTION
# ==============================================================================

# Encryption key for storing API credentials in database (Fernet key)
# Auto-generated if not provided, but MUST be consistent across restarts
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ CRITICAL: Keep this secret and backed up - losing it means losing stored credentials!
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# CORS Origins (comma-separated, use * for development only)
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# ML and Training Settings
ML_LIGHTWEIGHT_MODE=true
ENABLE_ML_TRAINING=false

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================

# Redis (for caching and background tasks)
# REDIS_URL=redis://localhost:6379

# MLflow (for ML model tracking)
# MLFLOW_TRACKING_URI=http://localhost:5000

# ==============================================================================
# DEVELOPMENT & TESTING
# ==============================================================================

# Set to true to use paper trading by default
# DEFAULT_PAPER_TRADING=true

# API rate limiting (requests per minute)
# API_RATE_LIMIT=60
